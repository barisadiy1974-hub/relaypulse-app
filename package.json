{
  "name": "relaypulse",
  "version": "1.5.8",
  "description": "Anyone relay/exit node SSH monitor",
  "homepage": "https://barisadiy1974-hub.github.io/relaypulse/",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/app.js && node --check src/config.js && node --check src/monitor.js && node --check src/ai-fixer.js"
  },
  "dependencies": {
    "@anyone-protocol/anyone-client": "^1.1.3"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.relaypulse.app",
    "productName": "RelayPulse",
    "asar": true,
    "files": [
      "**/*",
      "!**/*.md",
      "!tools/**"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png"
    }
  }
}